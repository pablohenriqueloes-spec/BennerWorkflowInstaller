<?xml version="1.0" encoding="utf-8"?>
<!-- Janela principal do HUB Benner: menu lateral de modulos e area de conteudo. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benner HUB" Width="1320" Height="900" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Back}" Foreground="{StaticResource Brush.Ink}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Menu lateral -->
    <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource Brush.Sidebar}"
            BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="22,22,22,18">
          <Image x:Name="LogoImage" Height="40" HorizontalAlignment="Left" Visibility="Collapsed"/>
          <TextBlock x:Name="BrandText" Text="benner" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}"/>
          <TextBlock Text="HUB de configurações" Style="{StaticResource Text.Muted}" Margin="2,4,0,0"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="22,14">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="AdminDot" Width="8" Height="8" Fill="{StaticResource Brush.Ok}" VerticalAlignment="Center"/>
              <TextBlock x:Name="AdminText" Text="Administrador" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="MachineText" Text="" Style="{StaticResource Text.Muted}" Margin="16,4,0,0"/>
          </StackPanel>
        </Border>
        <StackPanel>
          <TextBlock Text="MÓDULOS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Muted}" Margin="26,6,0,8"/>
          <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{StaticResource NavItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Conteudo -->
    <DockPanel Grid.Column="1" Grid.Row="0">
      <StackPanel DockPanel.Dock="Top" Margin="28,22,28,14">
        <TextBlock x:Name="PageEyebrow" Text="HUB BENNER" Style="{StaticResource Text.Eyebrow}" HorizontalAlignment="Left"/>
        <TextBlock x:Name="PageTitle" Text="Início" Style="{StaticResource Text.Title}" Margin="0,4,0,0"/>
        <TextBlock x:Name="PageSubtitle" Text="" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
      </StackPanel>
      <ContentControl x:Name="ModuleHost" Focusable="False"/>
    </DockPanel>

    <!-- Barra de status -->
    <Border Grid.Column="1" Grid.Row="1" Background="#0A0E15" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="28,6">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="PowerShell 5.1 · WPF" Style="{StaticResource Text.Muted}" FontSize="11.5"/>
        <TextBlock x:Name="StatusText" Text="Pronto" Style="{StaticResource Text.Muted}" FontSize="11.5"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
