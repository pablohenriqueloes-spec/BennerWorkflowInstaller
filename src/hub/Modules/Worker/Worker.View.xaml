<?xml version="1.0" encoding="utf-8"?>
<!--
  Tela do modulo Worker. Ordem: pacote e raiz; pastas de instalacao (campos por linha);
  previa/execucao/botoes; por ultimo, Workers instalados.
  Os cabecalhos com "marcar todos" das colunas de selecao sao criados no codigo.
-->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- Lista de escolha (fila) no tema escuro: o tema geral nao tem estilo de ComboBox. -->
    <Style x:Key="WorkerComboItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Brush.Ink}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selection}"/></Trigger>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WorkerCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Brush.Ink}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource WorkerComboItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource Brush.Input}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4">
                      <TextBlock Text="&#x25BE;" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Brush.Muted}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                <Border Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
          <Setter Property="IsEnabled" Value="False"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,4,28,20">

      <!-- 1. Pacote e raiz de instalacao -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="PACOTE E DESTINO" Style="{StaticResource Text.Eyebrow}" Margin="0,0,10,0"/>
            <TextBlock Text="De onde copiar e onde instalar" Style="{StaticResource Text.Section}"/>
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pasta do pacote (com Lib\, ou com as pastas worker23/worker25)" Style="{StaticResource Text.Label}"/>
            <TextBox x:Name="PackageBox" Grid.Row="1" Grid.Column="0" FontFamily="{StaticResource Font.Mono}" Text="E:\Benner\Worker"/>
            <Button x:Name="PackageBrowse" Grid.Row="1" Grid.Column="1" Content="Procurar..." Margin="10,0,0,0"/>
            <Button x:Name="PackageDetect" Grid.Row="1" Grid.Column="2" Content="Detectar" Margin="10,0,0,0"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Raiz de instalação (pastas e subpastas serão listadas)" Style="{StaticResource Text.Label}"/>
            <TextBox x:Name="RootBox" Grid.Row="1" Grid.Column="4" FontFamily="{StaticResource Font.Mono}" Text="E:\Benner\Ferramentas\Worker"/>
            <Button x:Name="RootBrowse" Grid.Row="1" Grid.Column="5" Content="Procurar..." Margin="10,0,0,0"/>
            <Button x:Name="ListButton" Grid.Row="1" Grid.Column="6" Content="Listar pastas" Style="{StaticResource Btn.Primary}" Margin="10,0,0,0"/>
          </Grid>
          <WrapPanel x:Name="PackagePanel" Margin="0,12,0,0"/>
          <TextBlock x:Name="PackageInfo" Text="Nenhum pacote detectado." Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <Border Height="1" Background="{StaticResource Brush.Line}" Margin="0,14,0,12"/>
          <TextBlock Text="Valores para novas linhas (e para o botão Aplicar às marcadas)" Style="{StaticResource Text.Label}"/>
          <WrapPanel>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Benner Server" Style="{StaticResource Text.Label}"/>
              <TextBox x:Name="DefaultServerBox" Width="200"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
              <TextBlock x:Name="DefaultFilaLabel" Text="Fila" Style="{StaticResource Text.Label}"/>
              <ComboBox x:Name="DefaultFilaBox" Width="260" Style="{StaticResource WorkerCombo}" DisplayMemberPath="[Label]" SelectedValuePath="[Value]"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
              <TextBlock x:Name="DefaultProvidersLabel" Text="Nº providers (0 = automático)" Style="{StaticResource Text.Label}"/>
              <TextBox x:Name="DefaultProvidersBox" Width="90" Text="0"/>
            </StackPanel>
            <StackPanel x:Name="DefaultWin32Panel" Margin="0,0,12,0">
              <TextBlock Text="Providers Win32" Style="{StaticResource Text.Label}"/>
              <TextBox x:Name="DefaultWin32Box" Width="90" Text="4"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
              <TextBlock x:Name="DefaultUserLabel" Text="Usuário" Style="{StaticResource Text.Label}"/>
              <TextBox x:Name="DefaultUserBox" Width="140" Text="SYSDBA"/>
            </StackPanel>
            <StackPanel x:Name="DefaultFlagsPanel" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,12,6">
              <CheckBox x:Name="DefaultPoolCheck" Content="Pool dinâmica" Margin="0,0,14,0"/>
              <CheckBox x:Name="DefaultComFreeCheck" Content="Usar COMFree"/>
            </StackPanel>
            <Button x:Name="ApplyDefaultsButton" Content="Aplicar às marcadas" VerticalAlignment="Bottom" IsEnabled="False"
                    ToolTip="Copia os valores acima para as linhas marcadas para instalar (Sistema e Nome de exibição não mudam)."/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- 2. Pastas de instalacao -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="CheckChildrenButton" Content="Marcar pastas das subpastas" IsEnabled="False" Margin="0,0,18,0"
                      ToolTip="Para cada pasta marcada: abre, marca todas as pastas de dentro e desmarca a pasta mãe."/>
              <TextBlock Text="Nova(s) pasta(s)" Style="{StaticResource Text.Muted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBox x:Name="NewFolderBox" Width="200" ToolTip="Nome(s) das pastas a criar, separados por ; ou ,. Criadas dentro de cada pasta marcada, ou na raiz se nada estiver marcado."/>
              <Button x:Name="AddFolderButton" Content="Adicionar" Margin="8,0,0,0" ToolTip="Cria as pastas agora, no disco."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="INSTALAÇÃO" Style="{StaticResource Text.Eyebrow}" Margin="0,0,10,0"/>
              <TextBlock Text="Pastas de instalação" Style="{StaticResource Text.Section}"/>
              <TextBlock x:Name="FoldersText" Text="0 pasta(s)" Style="{StaticResource Text.Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="300"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Pesquisar" Style="{StaticResource Text.Muted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBox x:Name="FolderSearch" Grid.Column="1"
                     ToolTip="Filtra por trecho em qualquer coluna (sem diferenciar maiúsculas). Use % ou * como curinga. Esc limpa."/>
            <TextBlock x:Name="FolderAlert" Grid.Column="2" Style="{StaticResource Text.Alert}" Margin="14,0,0,0" Visibility="Collapsed"/>
          </Grid>
          <DataGrid x:Name="FolderGrid" Height="360" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="96" MinWidth="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox Style="{StaticResource CellCheck}" IsChecked="{Binding [Install], UpdateSourceTrigger=PropertyChanged}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Pasta" Width="220" MinWidth="120" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="{Binding [Indent]}" ToolTip="{Binding [Path]}">
                      <Button Tag="Expand" Style="{StaticResource Btn.Ghost}" Width="26" Height="22" Padding="0" FontSize="10" FontWeight="Normal"
                              Content="{Binding [ExpandGlyph]}" Visibility="{Binding [ExpandVisibility]}" ToolTip="{Binding [ExpandTip]}"/>
                      <TextBlock Text="{Binding [Name]}" Style="{StaticResource CellMono}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Benner Server" Binding="{Binding [Servidor]}" Width="150" MinWidth="100"
                                  ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}"/>
              <DataGridTextColumn Header="Sistema" Binding="{Binding [Sistema]}" Width="130" MinWidth="90"
                                  ElementStyle="{StaticResource CellMono}" EditingElementStyle="{StaticResource CellEdit}"/>
              <DataGridTextColumn Header="Nome de exibição (editável)" Binding="{Binding [DisplayName]}" Width="280" MinWidth="160"
                                  ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}"/>
              <DataGridTemplateColumn Header="Fila" Width="240" MinWidth="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox Style="{StaticResource WorkerCombo}" Margin="2,1" Padding="6,2" ToolTip="{Binding [Fila]}"
                              ItemsSource="{Binding [QueueOptions]}" DisplayMemberPath="[Label]" SelectedValuePath="[Value]"
                              SelectedValue="{Binding [Fila], UpdateSourceTrigger=PropertyChanged}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Nº providers" Binding="{Binding [Providers]}" Width="100" MinWidth="80"
                                  ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}"/>
              <DataGridTextColumn Header="Win32" Binding="{Binding [Win32]}" Width="70" MinWidth="60"
                                  ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}"/>
              <DataGridTextColumn Header="Usuário" Binding="{Binding [Usuario]}" Width="110" MinWidth="80"
                                  ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}"/>
              <DataGridTemplateColumn Header="Pool dinâmica" Width="110" MinWidth="96">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox Style="{StaticResource CellCheck}" IsChecked="{Binding [PoolDinamica], UpdateSourceTrigger=PropertyChanged}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="COMFree" Width="90" MinWidth="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox Style="{StaticResource CellCheck}" IsChecked="{Binding [UseCOMFree], UpdateSourceTrigger=PropertyChanged}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Situação" Width="Auto" MinWidth="120" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Chip}" Tag="{Binding [StateKind]}" ToolTip="{Binding [State]}"><TextBlock Text="{Binding [State]}" MaxWidth="260" TextTrimming="CharacterEllipsis"/></Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Resultado" Width="Auto" MinWidth="130" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Chip}" Tag="{Binding [StatusKind]}" ToolTip="{Binding [StatusTip]}"><TextBlock Text="{Binding [Status]}"/></Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Caminho" Binding="{Binding [Path]}" IsReadOnly="True" Width="340" ElementStyle="{StaticResource CellMono}"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- 3. Previa, execucao e botoes -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.3*"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="SelectedCountText" DockPanel.Dock="Right" Text="0 selecionada(s)" Style="{StaticResource Text.Muted}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="PRÉVIA" Style="{StaticResource Text.Eyebrow}" Margin="0,0,10,0"/>
                  <TextBlock Text="Etapas das pastas marcadas" Style="{StaticResource Text.Section}"/>
                </StackPanel>
              </DockPanel>
              <TextBox x:Name="PreviewBox" Style="{StaticResource CodeBox}" Height="140"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="EXECUÇÃO" Style="{StaticResource Text.Eyebrow}" Margin="0,0,10,0"/>
                <TextBlock Text="Andamento do lote" Style="{StaticResource Text.Section}"/>
              </StackPanel>
              <TextBlock x:Name="SummaryText" Text="0 pasta(s) selecionada(s) para instalação" FontWeight="SemiBold" Margin="0,4,0,6"/>
              <TextBlock x:Name="ProgressText" Text="Pronto" Style="{StaticResource Text.Muted}" Margin="0,0,0,10" TextWrapping="Wrap"/>
              <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0"/>
              <TextBlock Text="Logs em C:\ProgramData\Benner\WorkerInstaller\Logs" Style="{StaticResource Text.Muted}" FontSize="11.5" Margin="0,10,0,0"/>
            </StackPanel>
          </Grid>
          <Border Height="1" Background="{StaticResource Brush.Line}" Margin="0,14,0,12"/>
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
              <CheckBox x:Name="StartAfterCheck" Content="Iniciar o serviço após instalar" IsChecked="True" Margin="0,0,16,0"/>
              <Button x:Name="LogsButton" Content="Abrir logs" Style="{StaticResource Btn.Ghost}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="InstallButton" Content="Instalar selecionados" Style="{StaticResource Btn.Primary}" IsEnabled="False"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- 4. Workers instalados -->
      <Border Style="{StaticResource Card}" Margin="0">
        <StackPanel>
          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <CheckBox x:Name="DeleteFolderCheck" Content="Apagar também a pasta" IsChecked="True" Margin="0,0,14,0"
                        ToolTip="Depois de excluir o serviço, apaga a pasta de instalação (só dentro da raiz de instalação e sem links/junctions)."/>
              <Button x:Name="RefreshButton" Content="Atualizar lista" Style="{StaticResource Btn.Ghost}"/>
              <Button x:Name="RemoveButton" Content="Remover selecionados..." Style="{StaticResource Btn.Danger}" IsEnabled="False" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="INSTALADOS" Style="{StaticResource Text.Eyebrow}" Margin="0,0,10,0"/>
              <TextBlock x:Name="InstalledTitle" Text="Benner Workers instalados no Windows" Style="{StaticResource Text.Section}"/>
            </StackPanel>
          </DockPanel>
          <WrapPanel Margin="0,0,0,10">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Usuário do Windows (DOMINIO\usuario)" Style="{StaticResource Text.Label}"/>
              <TextBox x:Name="AccountBox" Width="260" Text="DOMINIO\usuario"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Senha (vazia para gMSA)" Style="{StaticResource Text.Label}"/>
              <PasswordBox x:Name="PasswordInput" Width="220"/>
            </StackPanel>
            <Button x:Name="ChangeLoginButton" Content="Alterar login selecionados" Style="{StaticResource Btn.Info}"
                    IsEnabled="False" VerticalAlignment="Bottom"/>
          </WrapPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="300"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Pesquisar" Style="{StaticResource Text.Muted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBox x:Name="InstalledSearch" Grid.Column="1"
                     ToolTip="Filtra por trecho em qualquer coluna (sem diferenciar maiúsculas). Use % ou * como curinga. Esc limpa."/>
            <TextBlock x:Name="InstalledAlert" Grid.Column="2" Style="{StaticResource Text.Alert}" Margin="14,0,0,0" Visibility="Collapsed"/>
          </Grid>
          <DataGrid x:Name="InstalledGrid" Height="250">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="84" MinWidth="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox Style="{StaticResource CellCheck}" IsChecked="{Binding [LoginSel], UpdateSourceTrigger=PropertyChanged}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Width="104" MinWidth="98">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox Style="{StaticResource CellCheck}" IsChecked="{Binding [Remove], UpdateSourceTrigger=PropertyChanged}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Nome exibido" Binding="{Binding [Display]}" IsReadOnly="True" Width="260" MinWidth="140" ElementStyle="{StaticResource CellText}"/>
              <DataGridTextColumn Header="Versão" Binding="{Binding [Version]}" IsReadOnly="True" Width="70" MinWidth="60" ElementStyle="{StaticResource CellText}"/>
              <DataGridTemplateColumn Header="Status" Width="Auto" MinWidth="100" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Chip}" Tag="{Binding [StateKind]}"><TextBlock Text="{Binding [State]}"/></Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Conta de logon" Binding="{Binding [StartName]}" IsReadOnly="True" Width="170" MinWidth="110" ElementStyle="{StaticResource CellMono}"/>
              <DataGridTextColumn Header="Pasta do executável" Binding="{Binding [Folder]}" IsReadOnly="True" Width="320" MinWidth="180" ElementStyle="{StaticResource CellMono}"/>
              <DataGridTextColumn Header="Nome interno" Binding="{Binding [Name]}" IsReadOnly="True" Width="300" MinWidth="140" ElementStyle="{StaticResource CellMono}"/>
              <DataGridTemplateColumn Header="Resultado" Width="Auto" MinWidth="130" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Chip}" Tag="{Binding [ResultKind]}"><TextBlock Text="{Binding [Result]}"/></Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
